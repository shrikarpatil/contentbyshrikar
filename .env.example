# OpenAI (used by the existing research/screenplay agents and future image provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare

# Image generation
# local is free/offline; set to openai to opt into paid image generation
IMAGE_PROVIDER=local
IMAGE_QUALITY=medium
IMAGE_SIZE=1024x1536
IMAGE_COST_PER_IMAGE_USD=

# Local speech generation/transcription providers
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
TTS_INSTRUCTIONS=Warm confident documentary narration; natural conversational phrasing, varied intonation, clear articulation, not robotic or promotional.
WHISPER_MODEL=base
TRANSCRIPTION_PROVIDER=screenplay

# Media tools and output
FFMPEG_PATH=ffmpeg
OUTPUT_DIRECTORY=output
MUSIC_DIRECTORY=assets/music
AUTO_DOWNLOAD_MUSIC=true
SOUND_EFFECTS_DIRECTORY=assets/sound_effects
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
DEFAULT_VIDEO_DURATION=30
# YouTube upload (client_secret*.json in project root; token saved in credentials/)
YOUTUBE_PRIVACY=public
